{
  "id": "gym_classic_control",
  "name": "Gymnasium Classic Control",
  "kind": "env",
  "version": "1.2.0",
  "description": "Standard Gymnasium classic control environments: CartPole, MountainCar, Pendulum, and Acrobot.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "config_path": "env/gym_classic_control/acrobot.yaml",
  "config_paths": [
    "env/gym_classic_control/acrobot.yaml",
    "env/gym_classic_control/cartpole.yaml",
    "env/gym_classic_control/mountaincar.yaml",
    "env/gym_classic_control/pendulum.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "env/gym_classic_control/mountaincar.yaml": {
        "type": "object",
        "properties": {
          "monitor_metric": {
            "type": "string"
          },
          "preprocess_on_load": {
            "type": "boolean"
          },
          "env_id": {
            "type": "string"
          },
          "num_envs": {
            "type": "integer"
          },
          "num_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "env/gym_classic_control/pendulum.yaml": {
        "type": "object",
        "properties": {
          "monitor_metric": {
            "type": "string"
          },
          "preprocess_on_load": {
            "type": "boolean"
          },
          "env_id": {
            "type": "string"
          },
          "num_envs": {
            "type": "integer"
          },
          "num_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "env/gym_classic_control/acrobot.yaml": {
        "type": "object",
        "properties": {
          "monitor_metric": {
            "type": "string"
          },
          "preprocess_on_load": {
            "type": "boolean"
          },
          "env_id": {
            "type": "string"
          },
          "num_envs": {
            "type": "integer"
          },
          "num_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "env/gym_classic_control/cartpole.yaml": {
        "type": "object",
        "properties": {
          "monitor_metric": {
            "type": "string"
          },
          "preprocess_on_load": {
            "type": "boolean"
          },
          "env_id": {
            "type": "string"
          },
          "num_envs": {
            "type": "integer"
          },
          "num_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "components": [],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "gym_classic_control",
      "kind": "env",
      "entry_point": "env_vectorized.py:VectorizedEnv",
      "aliases": [
        "mountaincar",
        "gym_classic_control/mountaincar",
        "pendulum",
        "gym_classic_control/pendulum",
        "acrobot",
        "gym_classic_control/acrobot"
      ],
      "resource_root": ".",
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl"
          ]
        },
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl"
          ],
          "when": {
            "env.env_id": [
              "Acrobot-v1",
              "Pendulum-v1"
            ]
          },
          "message": "Acrobot and Pendulum have no offline datasets; use them in online_rl."
        }
      ]
    },
    {
      "id": "cartpole",
      "kind": "env",
      "entry_point": "env_vectorized.py:VectorizedEnv",
      "resource_root": "resources/cartpole",
      "aliases": [
        "gym_classic_control/cartpole"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl"
          ]
        }
      ]
    }
  ],
  "payload": {
    "implementations": [
      "env_vectorized.py",
      "resources/cartpole/valuation.py"
    ],
    "resources": [
      "resources",
      "requirements.txt"
    ],
    "configs": {
      "env/gym_classic_control/acrobot.yaml": "configs/env/gym_classic_control/acrobot.yaml",
      "env/gym_classic_control/cartpole.yaml": "configs/env/gym_classic_control/cartpole.yaml",
      "env/gym_classic_control/mountaincar.yaml": "configs/env/gym_classic_control/mountaincar.yaml",
      "env/gym_classic_control/pendulum.yaml": "configs/env/gym_classic_control/pendulum.yaml"
    }
  },
  "exports": {
    "cartpole_symbolic_observation": "resources/cartpole/valuation.py:build_symbolic_observation"
  },
  "repository": "https://github.com/CameronEgb/theta-plugins",
