  "parameter_schema": {
    "type": "object",
    "properties": {
      "hidden_sizes": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "activation": {
        "type": "string",
        "enum": [
          "relu",
          "gelu",
          "tanh",
          "elu",
          "silu",
          "sigmoid",
          "leaky_relu",
          "identity"
        ]
      },
      "shared_features": {
        "type": "boolean",
        "default": true,
        "description": "Share policy/value features. Disable for independent PPO actor and critic networks."
      },
      "dueling": {
        "type": "boolean",
        "description": "Use dueling Q-value heads; defaults to enabled for widths >=128."
      }
    }
  },
