{
  "id": "neumann",
  "name": "NEUMANN Neural Symbolic Reasoner",
  "kind": "model",
  "version": "1.1.1",
  "description": "Neuro-symbolic message passing reasoner over logic graphs.",
  "author": {
    "name": "Hikaru Shindo"
  },
  "config_path": "model/neumann.yaml",
  "config_paths": [
    "model/neumann.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "rules": {
        "type": "string",
        "x-theta-resource": "rules",
        "x-theta-actions": [
          {
            "type": "open-in-editor",
            "label": "Open rules folder"
          }
        ],
        "description": "Ruleset entry environment/name, or a bare name resolved against the experiment environment's symbolic name."
      },
      "logic_type": {
        "type": "string"
      }
    }
  },
  "dependencies": {
    "components": [
      "nsfr"
    ],
    "pip": [
      "torch-geometric",
      "networkx",
      "joblib"
    ]
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "neumann",
      "kind": "model",
      "entry_point": "common.py:get_neumann_model",
      "aliases": []
    }
  ],
  "payload": {
    "implementations": [
      "logic_utils.py",
      "reasoning_graph.py",
      "neumann.py",
      "soft_logic.py",
      "__init__.py",
      "refinement.py",
      "facts_converter.py",
      "common.py",
      "message_passing.py",
      "scatter.py",
      "torch_utils.py",
      "fol/__init__.py",
      "fol/logic.py",
      "fol/data_utils.py",
      "fol/language.py",
      "fol/logic_ops.py",
      "fol/exp_parser.py"
    ],
    "resources": [
      "lark",
      "fol/exp.lark"
    ],
    "configs": {
      "model/neumann.yaml": "configs/model/neumann.yaml"
    }
  },
  "exports": {
    "get_blender_neumann_model": "common.py:get_blender_neumann_model",
    "get_neumann_model": "common.py:get_neumann_model"
  },
  "repository": "https://github.com/CameronEgb/theta-plugins",
  "license": "MIT",
  "tags": [
    "model",
    "neuro-symbolic",
    "neumann",
    "logic",
    "graph-reasoning",
    "message-passing"
  ],
