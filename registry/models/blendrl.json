  "config_path": "in/config/model/blendrl.yaml",
  "config_paths": [
    "in/config/model/blendrl.yaml",
    "in/config/plot/blendrl/blend_routing.yaml"
  ],
  "paradigms": [
    "online_rl",
    "offline_rl"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "actor_mode": {
        "type": "string",
        "enum": [
          "hybrid",
          "logic",
          "neural"
        ]
      },
      "blender": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "neural",
              "symbolic"
            ],
            "x-theta-hide-label": true
          },
          "model": {
            "type": "object",
            "x-theta-domain": "model",
            "description": "Model used to produce blender weights."
          }
        }
      },
      "blend_function": {
        "type": "string",
        "enum": [
          "softmax",
          "gumbel_softmax"
        ]
      },
      "blend_q_values": {
        "type": "boolean"
      },
      "blend_ent_coef": {
        "type": "number"
      },
      "logic_lr": {
        "type": "number"
      },
      "blender_lr": {
        "type": "number"
      },
      "neural": {
        "type": "string",
        "x-theta-domain": "model",
        "description": "Neural policy and critic module."
      },
      "symbolic": {
        "type": "string",
        "x-theta-domain": "model",
        "description": "Symbolic reasoning module."
      },
      "monitoring_interval": {
        "type": "integer",
        "minimum": 0,
        "description": "SB3 environment steps between routing summaries; 0 disables."
      },
      "monitoring_max_samples": {
        "type": "integer",
        "minimum": 0,
        "description": "Maximum recent observations to save for routing plots; 0 disables."
      }
    }
  },
  "dependencies": {
    "components": [
      "dnn",
      "nsfr",
      "neumann"
    ]
  }
}
