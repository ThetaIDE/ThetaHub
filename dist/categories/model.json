        "blendrl",
        "hybrid",
        "neural-symbolic",
        "nsfr",
        "logic",
        "rl"
      ],
      "dependencies": {
        "components": [
          "dnn",
          "nsfr",
          "neumann"
        ],
        "pip": [
          "captum",
          "lark"
        ]
      },
      "config_path": "model/blendrl.yaml",
